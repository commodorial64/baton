-- operator precedence and associativity
fn main() -> i {
    print(1 + 2 * 3)
    print((1 + 2) * 3)
    print(1 | 2 == 2)
    print(1 | 2 == 3)
    print((1 | 2) == 2)
    print(2 ** 3 ** 2)
    print(-2 ** 2)
    print(7 / 2, -7 / 2, 7 % 3, -7 % 3)
    print(1 << 4, 256 >> 4)
    print(5 & 3, 5 | 3, 5 ^ 3)
    print(1 < 2, 2 <= 2, 3 > 4, 4 >= 4, 5 == 5, 5 != 5)
    print(true and false, true or false, not true)
    return 0
}
