#ifndef SHARPE_BTL
#define SHARPE_BTL

/* SDL2 bindings for Baton (sharpe).
 *
 * Header-only: the implementations live here so a baton program can use the
 * module with a single gcc invocation.  The compiler reads the prototypes
 * below and adds the link flags requested by the directive.
 *
 * The baton-facing prototypes use int64_t (baton's `i`) and cast to SDL's
 * narrower types inside, so `i` values and `&i` pointers have the size baton
 * expects. */

/* baton:link -lSDL2 */

#include <SDL2/SDL.h>
#include <stdint.h>
#include <string.h>

int64_t sharpe_init(void);
void sharpe_quit(void);
void* sharpe_create_window(const char *title, int64_t x, int64_t y, int64_t w, int64_t h, int64_t flags);
void* sharpe_create_renderer(void *window, int64_t index, int64_t flags);
int64_t sharpe_poll_event(int64_t *type, int64_t *key, int64_t *x, int64_t *y, int64_t *button, int64_t *xrel, int64_t *yrel);
void sharpe_render_clear(void *renderer);
void sharpe_render_present(void *renderer);
void sharpe_set_draw_color(void *renderer, uint8_t r, uint8_t g, uint8_t b, uint8_t a);
int64_t sharpe_draw_point(void *renderer, int64_t x, int64_t y);
int64_t sharpe_draw_line(void *renderer, int64_t x1, int64_t y1, int64_t x2, int64_t y2);
int64_t sharpe_draw_rect(void *renderer, int64_t x, int64_t y, int64_t w, int64_t h);
int64_t sharpe_fill_rect(void *renderer, int64_t x, int64_t y, int64_t w, int64_t h);
void sharpe_delay(int64_t ms);
int64_t sharpe_get_ticks(void);
int64_t sharpe_get_error(char *buf, int64_t len);

int64_t sharpe_init(void) {
    return SDL_Init(SDL_INIT_VIDEO | SDL_INIT_EVENTS);
}

void sharpe_quit(void) {
    SDL_Quit();
}

void* sharpe_create_window(const char *title, int64_t x, int64_t y, int64_t w, int64_t h, int64_t flags) {
    return SDL_CreateWindow(title, (int)x, (int)y, (int)w, (int)h, (Uint32)flags);
}

void* sharpe_create_renderer(void *window, int64_t index, int64_t flags) {
    return SDL_CreateRenderer((SDL_Window*)window, (int)index, (Uint32)flags);
}

int64_t sharpe_poll_event(int64_t *type, int64_t *key, int64_t *x, int64_t *y, int64_t *button, int64_t *xrel, int64_t *yrel) {
    SDL_Event e;
    if (!SDL_PollEvent(&e)) return 0;
    if (type) *type = (int64_t)e.type;
    if (key) *key = 0;
    if (x) *x = 0;
    if (y) *y = 0;
    if (button) *button = 0;
    if (xrel) *xrel = 0;
    if (yrel) *yrel = 0;
    if (e.type == SDL_KEYDOWN || e.type == SDL_KEYUP) {
        if (key) *key = (int64_t)e.key.keysym.sym;
    } else if (e.type == SDL_MOUSEMOTION) {
        if (x) *x = (int64_t)e.motion.x;
        if (y) *y = (int64_t)e.motion.y;
        if (xrel) *xrel = (int64_t)e.motion.xrel;
        if (yrel) *yrel = (int64_t)e.motion.yrel;
    } else if (e.type == SDL_MOUSEBUTTONDOWN || e.type == SDL_MOUSEBUTTONUP) {
        if (x) *x = (int64_t)e.button.x;
        if (y) *y = (int64_t)e.button.y;
        if (button) *button = (int64_t)e.button.button;
    }
    return 1;
}

void sharpe_render_clear(void *renderer) {
    SDL_RenderClear((SDL_Renderer*)renderer);
}

void sharpe_render_present(void *renderer) {
    SDL_RenderPresent((SDL_Renderer*)renderer);
}

void sharpe_set_draw_color(void *renderer, uint8_t r, uint8_t g, uint8_t b, uint8_t a) {
    SDL_SetRenderDrawColor((SDL_Renderer*)renderer, r, g, b, a);
}

int64_t sharpe_draw_point(void *renderer, int64_t x, int64_t y) {
    return SDL_RenderDrawPoint((SDL_Renderer*)renderer, (int)x, (int)y);
}

int64_t sharpe_draw_line(void *renderer, int64_t x1, int64_t y1, int64_t x2, int64_t y2) {
    return SDL_RenderDrawLine((SDL_Renderer*)renderer, (int)x1, (int)y1, (int)x2, (int)y2);
}

int64_t sharpe_draw_rect(void *renderer, int64_t x, int64_t y, int64_t w, int64_t h) {
    SDL_Rect rect = {(int)x, (int)y, (int)w, (int)h};
    return SDL_RenderDrawRect((SDL_Renderer*)renderer, &rect);
}

int64_t sharpe_fill_rect(void *renderer, int64_t x, int64_t y, int64_t w, int64_t h) {
    SDL_Rect rect = {(int)x, (int)y, (int)w, (int)h};
    return SDL_RenderFillRect((SDL_Renderer*)renderer, &rect);
}

void sharpe_delay(int64_t ms) {
    SDL_Delay((Uint32)ms);
}

int64_t sharpe_get_ticks(void) {
    return (int64_t)SDL_GetTicks();
}

int64_t sharpe_get_error(char *buf, int64_t len) {
    const char *err = SDL_GetError();
    if (!err || len <= 0) return 0;
    strncpy(buf, err, (size_t)(len - 1));
    buf[len - 1] = '\0';
    return 1;
}

#endif
