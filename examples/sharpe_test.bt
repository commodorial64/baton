mod sharpe get-from <sharpe>

fn main() -> i {
    if sharpe.init() != 0 {
        return 1
    }

    *i local win = sharpe.window(cstr("baton sharpe"), 640, 480)
    *i local ren = sharpe.renderer(win)

    sharpe.color(ren, 0, 100, 200)
    sharpe.clear(ren)
    sharpe.present(ren)
    sharpe.wait(100)
    sharpe.quit()
    return 0
}
